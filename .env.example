# Copy to .env for local development and set unique secrets. Never commit .env.
PORT=3000
SEED_DEMO_USERS=false
SEED_DEMO_DATA=false
JWT_SECRET=replace-with-a-long-unique-secret
APP_ENCRYPTION_KEY=replace-with-a-unique-32-byte-key
APP_BASE_URL=http://localhost:3000
APP_ENV=development
ALLOW_TEST_DATA_RESET=false
TEST_RESET_BACKUP_RETENTION=3
# Render persistent disk example; set paths only with the mounted disk configured.
# RENDER_PERSISTENT_ROOT=/var/data
# DATA_DIR=/var/data/data
# UPLOAD_DIR=/var/data/uploads
