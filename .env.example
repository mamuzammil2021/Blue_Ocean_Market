# Copy to .env for local use if your process manager loads env files.
# On Render, configure these in Environment settings instead.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=replace-with-your-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password
NODE_ENV=production
# Optional persistent paths. For one Render disk mounted at /var/data, use
# DATA_DIR=/var/data/data and UPLOAD_DIR=/var/data/uploads.
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Development/testing only. These inserts are additive and never wipe data.
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=replace-with-one-shared-test-password-at-least-12-characters
SEED_DEMO_DATA=true
