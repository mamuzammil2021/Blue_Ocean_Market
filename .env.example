# Copy to .env for LOCAL development only. Never commit real credentials.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
JWT_SECRET=
APP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_USERS=false
SEED_DEMO_DATA=false
ALLOW_TEST_DATA_RESET=false
TEST_RESET_BACKUP_RETENTION=3
# On existing Render persistent disk, configure paths in Render environment instead:
RENDER_PERSISTENT_ROOT=/var/data
DATA_DIR=/var/data/data
UPLOAD_DIR=/var/data/uploads
RENDER_REQUIRE_PERSISTENT_DISK=true
