# Blue Ocean Market environment template
PORT=3000
# Set to the public HTTPS origin used for password reset links.
APP_BASE_URL=https://your-blue-ocean-host.example
# Use a long random value in production; do not commit a real key.
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Render persistent storage (example)
# DATA_DIR=/var/data/blue-ocean
