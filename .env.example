# Blue Ocean Market V30.24.3 environment template.
# Never commit real credentials. Render secrets belong in Render > Environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
APP_BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@blueocean.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password-at-least-12-characters
LOCAL_TEST_MODE=false
LOCAL_TEST_ADMIN_EMAIL=admin@blueocean.local
LOCAL_TEST_ADMIN_PASSWORD=replace-with-local-test-password
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=replace-with-one-shared-test-password-at-least-12-characters
SEED_DEMO_DATA=false

# Render paid web service + persistent disk (recommended mount path: /var/data)
# The app auto-detects RENDER=true and uses these paths even when DATA_DIR/UPLOAD_DIR are omitted.
# Set them explicitly in the Render dashboard for clarity.
# RENDER_PERSISTENT_ROOT=/var/data
# DATA_DIR=/var/data/data
# UPLOAD_DIR=/var/data/uploads
# RENDER_REQUIRE_PERSISTENT_DISK=true
# APP_BASE_URL may be omitted on Render when you use the default onrender.com URL;
# the app falls back to Render's RENDER_EXTERNAL_URL. Set APP_BASE_URL explicitly for a custom domain.
