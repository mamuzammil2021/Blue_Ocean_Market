diff --git a/qa/qa_v36939_financial_guards.js b/qa/qa_v36939_financial_guards.js
new file mode 100644
index 0000000..d18c00c
--- /dev/null
+++ b/qa/qa_v36939_financial_guards.js
@@ -0,0 +1,10 @@
+'use strict';
+const assert=require('assert/strict'),fs=require('fs'),cp=require('child_process'),{fixture}=require('./fx_fixture');
+(async()=>{let f,child;const checks=[],pass=x=>{checks.push(x);console.log('PASS '+x)};try{f=await fixture();child=f.child;await new Promise(r=>{child.once('exit',r);child.kill('SIGTERM')});const db=f.db,now=new Date().toISOString().slice(0,10);
+ for(const x of db.prepare("SELECT name,sql FROM sqlite_master WHERE type='index' AND tbl_name='finance_entries'").all())if(x.sql&&/UNIQUE/i.test(x.sql)&&/source_type/i.test(x.sql))db.exec('DROP INDEX "'+x.name+'"');
+ const base={business_unit_id:f.pink,type:'Expense',category:'General',amount:25000,krw_amount:25000,original_amount:25000,original_currency:'KRW',fx_rate:1,transaction_date:now,description:'Synthetic historical Finance review',status:'Recorded',created_by:1,verification_status:'Pending Verification',cash_effect:0};const duplicateIds=[];for(let i=0;i<2;i++)duplicateIds.push(f.ins('finance_entries',{...base,source_type:'Pink Salt Import Purchase',source_id:f.imports[0],source_key:'QA39-DUP-'+i}));
+ const voided=f.ins('finance_entries',{...base,status:'Voided',source_type:'Manual',source_key:'QA39-OLD-VOID',void_reason:'Historical reason without recorded actor',voided_by:null}),changed=f.ins('finance_entries',{...base,source_type:'Manual',source_key:'QA39-CHANGED',cash_effect:-1});const j1=f.ins('accounting_journal_entries',{journal_no:'QA39-LEGACY-UNPOSTED',business_unit_id:f.pink,transaction_date:now,source_type:'Finance Entry',source_id:voided,finance_entry_id:voided,status:'Pending Review',source_hash:'legacy',created_by:1}),j2=f.ins('accounting_journal_entries',{journal_no:'QA39-LEGACY-POSTED',business_unit_id:f.pink,transaction_date:now,source_type:'Finance Entry',source_id:changed,finance_entry_id:changed,status:'Posted',source_hash:'legacy',created_by:1});
+ db.prepare("DELETE FROM system_migrations WHERE migration_key='v30.39.2-v302-finance-integrity-bootstrap'").run();const snapshot=()=>db.prepare('SELECT id,status,amount,krw_amount,void_reason,voided_by,voided_at FROM finance_entries ORDER BY id').all(),before=snapshot();
+ async function start(){child=cp.spawn(process.execPath,['server/server.js'],{cwd:f.root,env:f.env,stdio:['ignore','pipe','pipe']});let log='';child.stdout.on('data',x=>log+=x);child.stderr.on('data',x=>log+=x);for(let i=0;i<220;i++){if(child.exitCode!==null)throw Error(log);try{if((await fetch(f.base+'/api/health')).ok)return}catch(_){}await new Promise(r=>setTimeout(r,100))}throw Error(log)}
+ for(let i=0;i<2;i++){await start();await new Promise(r=>setTimeout(r,600));assert.deepEqual(snapshot(),before);assert.equal(db.prepare('SELECT status FROM accounting_journal_entries WHERE id=?').get(j1).status,'Pending Review');assert.equal(db.prepare('SELECT status FROM accounting_journal_entries WHERE id=?').get(j2).status,'Posted');assert.equal(db.prepare('SELECT COUNT(*) n FROM accounting_journal_entries WHERE reversal_of_id IN (?,?)').get(j1,j2).n,0);pass(i?'Repeated startup preserves duplicates, legacy void and both journal statuses':'Upgrade startup neither consolidates duplicates nor cancels/reverses legacy journals');const response=await f.api('POST','/api/finance/integrity-v302/repair',{});assert(response.ok);assert(response.j.review_required);assert.equal(response.j.voided,0);assert.deepEqual(snapshot(),before);pass('User diagnostic request reports duplicate groups without bulk financial mutation');await new Promise(r=>{child.once('exit',r);child.kill('SIGTERM')})}
+ assert.equal(db.pragma('foreign_key_check').length,0);pass('Legacy review fixtures retain valid foreign keys');fs.writeFileSync('qa/evidence/36939-financial-guards.json',JSON.stringify({status:'PASS',checks,production_data_used:false,finance_ids:duplicateIds,legacy_journal_ids:[j1,j2]},null,2));}catch(e){console.error(e);fs.writeFileSync('qa/evidence/36939-financial-guards.json',JSON.stringify({status:'FAIL',checks,error:e.message},null,2));process.exitCode=1}finally{if(child?.exitCode===null)await new Promise(r=>{child.once('exit',r);child.kill('SIGTERM')});f?.db.close()}})();
