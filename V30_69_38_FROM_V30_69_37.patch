+.nav .pack-sidebar>button{display:flex;align-items:center;text-align:left;width:100%;min-height:40px;padding:9px 12px 9px 44px!important;font:inherit;font-size:13px;border-left:2px solid transparent}
+.nav .pack-sidebar>button.active{border-left-color:#9ec5ff}.nav .pack-sidebar>summary:focus-visible{outline:2px solid #9ec5ff;outline-offset:2px}
+.side.collapsed .pack-sidebar>summary{justify-content:center;padding:11px 5px}.side.collapsed .pack-sidebar .pack-nav-arrow{display:none}.side.collapsed .pack-sidebar>button{padding:8px 3px!important;font-size:10px;text-align:center;justify-content:center;overflow-wrap:anywhere}
+.ps-ux-page{min-width:0}.ps-ux-page .section-title{gap:12px;flex-wrap:wrap}.ps-ux-page .ps313-filter{align-items:flex-end;gap:12px;flex-wrap:wrap}.ps-ux-page .ps313-filter .field{flex:0 1 180px;min-width:140px;margin:0}.ps-ux-page .ps313-filter .field.search{flex:1 1 260px;max-width:420px}.ps-ux-page .ps313-filter input,.ps-ux-page .ps313-filter select{min-height:38px;height:38px}.ps-ux-page .ps313-filter .btn{min-height:38px;width:auto;align-self:flex-end}
+.ps-ux-page .bom-server-pager{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-top:12px}.ps-ux-page .bom-server-pager .muted{margin-right:auto}
+.ps-ux-table{width:100%;border-collapse:separate;border-spacing:0}.ps-ux-table td{vertical-align:top}.ps-ux-table th:last-child,.ps-ux-table td:last-child{position:sticky;right:0;background:var(--card,#fff);z-index:2;box-shadow:-5px 0 8px rgba(20,40,80,.04);min-width:180px;max-width:280px;white-space:normal!important;text-align:left!important}
