+/* V30.69.38 — scoped Pink Salt navigation and catalog page layout. */
+.nav .pack-sidebar{margin:0;padding:0;border:0;color:inherit}
+.nav .pack-sidebar>summary{display:flex;align-items:center;gap:10px;list-style:none;border-radius:10px;padding:11px 12px;font:inherit;font-weight:500;color:#aebbd0;cursor:pointer;min-height:44px}
+.nav .pack-sidebar>summary::-webkit-details-marker{display:none}.nav .pack-sidebar>summary::marker{content:''}
+.nav .pack-sidebar>summary:hover{background:#1b2d4d;color:#fff}.nav .pack-sidebar>summary.active{background:#1b2d4d;color:#fff}
+.nav .pack-sidebar .nav-label{flex:1;min-width:0;white-space:normal;overflow:visible;line-height:1.3}.nav .pack-nav-arrow{margin-left:auto;flex:0 0 18px;text-align:center;transition:transform .15s;line-height:1}
