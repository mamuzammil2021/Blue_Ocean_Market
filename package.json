{
  "name": "blue-ocean-market-os",
  "version": "30.26.2",
  "private": true,
  "description": "Blue Ocean Market full-stack management operating system",
  "main": "server/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-server.js",
    "dev": "node --env-file-if-exists=.env --watch scripts/start-server.js",
    "start:local": "node --env-file-if-exists=.env scripts/start-server.js",
    "dev:local": "node --env-file-if-exists=.env --watch scripts/start-server.js",
    "qa:current": "node qa/qa_current.js",
    "qa:runtime": "node qa/runtime_smoke.js",
    "render:storage-check": "node scripts/render-storage-check.js",
    "render:migrate-storage": "node scripts/migrate-render-storage.js",
    "qa:render": "node qa/qa_render_persistence.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  }
