+/* Packaging uses the shared Imports cards, tables, filters and dialog footer.
+   These scoped layout rules prevent generic field/action styles stretching controls. */
+.ps-packaging .pack-toolbar{display:flex!important;align-items:flex-end!important;justify-content:flex-start;flex-wrap:wrap;gap:12px;padding:0;margin:0 0 16px;min-width:0}
+.ps-packaging .pack-search{display:flex!important;align-items:flex-end;gap:8px;flex:1 1 300px;max-width:480px;min-width:0;margin:0;padding:0}
+.ps-packaging .pack-toolbar .field{display:flex;flex-direction:column;gap:5px;margin:0;min-width:0;align-self:auto}
+.ps-packaging .pack-search>.field{flex:1;min-width:120px}
+.ps-packaging .pack-toolbar>.field{flex:0 1 170px;width:170px}
+.ps-packaging .pack-toolbar input,.ps-packaging .pack-toolbar select{box-sizing:border-box;width:100%;height:38px!important;min-height:38px!important;padding:7px 10px;font:inherit;font-size:14px;border:1px solid var(--line);border-radius:8px;background:#fff}
+.ps-packaging .pack-toolbar .btn{height:38px!important;min-height:38px!important;width:auto;flex:0 0 auto;align-self:flex-end;padding:7px 12px;white-space:nowrap;font-size:14px;line-height:20px}
+.ps-packaging .pack-toolbar-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-left:auto;align-self:flex-end}
+.ps-packaging .pack-kpis{gap:10px;margin:12px 0 16px}
+.ps-packaging .pack-kpi{display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:5px;padding:12px 14px;background:#fff;color:var(--ink);border:1px solid var(--line);border-radius:12px;font:inherit;cursor:pointer;min-width:0}
+.ps-packaging .pack-kpi small{color:var(--muted);font-size:12px;font-weight:600}.ps-packaging .pack-kpi b{font-size:22px;line-height:1.2}
+.ps-packaging .pack-kpi:hover{border-color:var(--brand)}
+.ps-packaging .table td{padding:10px;vertical-align:top}.ps-packaging .table th{font-size:11px}
+.ps-packaging .pack-row-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-start;gap:5px;min-width:210px;max-width:300px}
+.ps-packaging .pack-row-actions .btn{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:auto;min-height:30px;height:auto;padding:5px 9px;font-size:12px;line-height:18px;white-space:nowrap}
+.pack-meta{display:block;color:var(--muted);font-size:12px;line-height:1.5;margin-top:3px}.ps-packaging .pill{display:inline-block;margin:2px 2px 2px 0;font-size:11px;padding:3px 7px;white-space:nowrap}
+.ps-packaging .bom-server-pager{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap;margin-top:12px}.ps-packaging .bom-server-pager>.muted{margin-right:auto}
+.pack-page-disabled{opacity:.45;cursor:default}
+.pack-dialog .pack-check{display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;width:fit-content!important;max-width:100%;margin:12px 0!important;padding:8px 0;cursor:pointer;text-align:left}
+.pack-dialog .pack-check input[type=checkbox]{display:inline-block!important;width:18px!important;min-width:18px!important;max-width:18px!important;height:18px!important;min-height:18px!important;flex:0 0 18px!important;margin:0!important;padding:0!important;accent-color:var(--brand);position:static!important}
+.pack-dialog .pack-check span{flex:0 1 auto;line-height:1.4;font-size:14px;white-space:normal}
+.pack-dialog .field{margin-bottom:8px}.pack-dialog .grid{gap:10px 16px}.pack-dialog .pack-receipt-fields{align-items:start}
+.pack-dialog .pack-receiving-lines .table{min-width:700px}.pack-dialog .pack-receiving-lines .table th,.pack-dialog .pack-receiving-lines .table td{padding:8px;vertical-align:middle}
+.pack-dialog .pack-receiving-lines input[type=number]{width:100%!important;min-width:75px;max-width:110px;height:36px!important;min-height:36px!important;padding:6px 8px}
+.pack-dialog .pack-footer{display:flex!important;align-items:center;justify-content:flex-end;gap:8px}.pack-dialog .pack-footer .btn{flex:0 0 auto;width:auto;min-height:38px;padding:8px 14px}
+@media(max-width:700px){
+ .ps-packaging .pack-toolbar{gap:10px}.ps-packaging .pack-search{flex:1 1 100%;max-width:none}.ps-packaging .pack-toolbar>.field{flex:1 1 130px;width:auto}.ps-packaging .pack-toolbar-actions{margin-left:0;flex:1 1 auto;justify-content:flex-end}
+ .ps-packaging .pack-toolbar .btn,.ps-packaging .pack-toolbar input,.ps-packaging .pack-toolbar select{height:40px!important;min-height:40px!important}
+ .ps-packaging .pack-row-actions{min-width:190px;max-width:250px}.ps-packaging .pack-row-actions .btn{min-height:36px}.ps-packaging .pack-kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ps-packaging .pack-kpi{padding:10px}
+ .pack-dialog .pack-footer .btn{min-height:44px}.pack-dialog .pack-check input[type=checkbox]{min-height:18px!important;height:18px!important}
+}
+.pack-dialog .pack-receiving-lines input[type=number]{box-sizing:border-box;border:1px solid var(--line);border-radius:8px;background:#fff;font:inherit;font-size:14px}
+@media(min-width:701px){.modal:has(.pack-dialog){width:min(1040px,96vw)!important;max-width:1040px!important}}
